# Shared template: copy this file to .env, then edit your local copy.
# Commit .env.example; NEVER commit .env or put real keys in this template.
# Instructions: docs/WEB_APP.md. Compose and scripts/run_web.py read .env.

# Choose: fixture (scripted demo), retrieval (real search), live (real answers).
RAG_MODE=fixture
RAG_RETRIEVAL=bm25
# Explicitly select the synthetic benchmark demo identity (not real login).
RAG_DEMO_ACCESS=true
RAG_ALLOW_PAID=false
RAG_BUDGET_USD=0

# Live mode only: use your own key, model, prices and spending cap.
# Change RAG_MODE to live and RAG_ALLOW_PAID to true above.
# Prices are USD per million tokens. Zero budget/prices disable live startup.
ANTHROPIC_API_KEY=
RAG_MODEL=
RAG_INPUT_PRICE=0
RAG_OUTPUT_PRICE=0
RAG_QUESTION_BUDGET_USD=0.10

# Docker: host folder mounted read-only at /data. Download artifacts separately.
ARTIFACTS_DIR=./.cache/corpus
WEB_PORT=8000
INSTALL_HYBRID=false
# Optional settings: uncomment only when needed.
# RAG_CORPUS=/data/documents.parquet # Paths INSIDE the container
# RAG_BM25_INDEX=/data/indexes/bm25
# RAG_DENSE_INDEX=/data/indexes/dense-bge-base
# Hybrid: change RAG_RETRIEVAL above to hybrid and INSTALL_HYBRID to true; rebuild.
# RAG_FP16=false                     # Must match the index; unset uses manifest
# RAG_BM25_WEIGHT=0.7
# RAG_CANDIDATE_K=50
# RAG_RERANK_K=50
# RAG_RRF_K=60
# RAG_ALLOWED_DOC_IDS_FILE=/data/scope.json
# RAG_ALLOWED_SOURCES=confluence,slack
