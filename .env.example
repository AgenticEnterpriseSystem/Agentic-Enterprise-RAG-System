# Shared template: copy this file to .env, then edit your local copy.
# Commit .env.example; NEVER commit .env or put real keys in this template.
# Instructions: docs/WEB_APP.md. Compose and scripts/run_web.py read .env.

# Choose: fixture (scripted demo), retrieval (real search), live (real answers).
RAG_MODE=fixture
RAG_RETRIEVAL=hybrid
# Explicitly select the synthetic benchmark demo identity (not real login).
RAG_DEMO_ACCESS=true
RAG_ALLOW_PAID=false
RAG_BUDGET_USD=0

# Live mode only: use your own key, model, prices and spending cap.
# Change RAG_MODE to live and RAG_ALLOW_PAID to true above.
# Prices are USD per million tokens. Zero budget/prices disable live startup.
ANTHROPIC_API_KEY=
RAG_MODEL=
RAG_INPUT_PRICE=0
RAG_OUTPUT_PRICE=0
RAG_QUESTION_BUDGET_USD=0.10

# Docker: host folder mounted read-only at /data. Download artifacts separately.
ARTIFACTS_DIR=./.cache/hybrid-artifacts
WEB_PORT=8000
INSTALL_HYBRID=true
# Optional settings: uncomment only when needed.
# RAG_CORPUS=/data/documents.parquet # Paths INSIDE the container
# RAG_BM25_INDEX=/data/indexes/bm25
RAG_DENSE_INDEX=/data/indexes/dense-bge-base
# RAG_FP16=false                     # Must match the index; unset uses manifest
# RAG_BM25_WEIGHT=0.7
# RAG_CANDIDATE_K=50
# RAG_RERANK_K=50
# RAG_RRF_K=60
# RAG_ALLOWED_DOC_IDS_FILE=/data/scope.json
# RAG_ALLOWED_SOURCES=confluence,slack

# Optional database foundation: enable database/migrations profiles explicitly.
# Set three different local secrets before the first database-volume creation.
# Leave these blank in the shared template; login provisioning comes later.
RAG_DB_BOOTSTRAP_PASSWORD=
RAG_DB_MIGRATOR_PASSWORD=
RAG_DB_RUNTIME_PASSWORD=
# Structured runtime DB settings for later integration; no password in a URL.
# RAG_DB_HOST=db
# RAG_DB_PORT=5432
# RAG_DB_NAME=rag
# RAG_DB_USER=rag_runtime
# RAG_DB_PASSWORD=<your local runtime role secret>

# Operator import target; the web application is connected in a later ticket.
RAG_SNAPSHOT_ID=enterprise-bge-base-canonical

# Local account API; benchmark is the existing explicitly labeled demo profile.
RAG_AUTH_MODE=benchmark
# Optional true/false alias. Keep blank when selecting the mode above.
RAG_AUTH_ENABLED=
# Empty uses RAG_ALLOWED_ORIGINS; HTTPS deployments set explicit HTTPS origins.
RAG_AUTH_ALLOWED_ORIGINS=
RAG_AUTH_SECURE_COOKIES=true
# HTTP requires secure=false plus this explicit loopback-only exception.
RAG_AUTH_ALLOW_INSECURE_LOOPBACK=false
RAG_AUTH_IDLE_SECONDS=1800
RAG_AUTH_ABSOLUTE_SECONDS=28800
