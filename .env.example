# Local authenticated full-corpus stack. Never commit .env or real credentials.
# scripts/local_stack.py init creates an exclusive0600 copy with fresh DB secrets.
COMPOSE_PROJECT_NAME=redwood
RAG_APP_IMAGE=redwood-rag:local
RAG_OPERATOR_IMAGE=redwood-rag-operator:local
WEB_PORT=8000
INSTALL_HYBRID=true
RAG_MODE=retrieval
RAG_RETRIEVAL=hybrid
RAG_DEMO_ACCESS=false
RAG_AUTH_MODE=local
RAG_ALLOW_PAID=false
RAG_BUDGET_USD=0

# Read-only preparation inputs, copied/verified into Linux-managed volumes.
ARTIFACTS_DIR=./.cache/hybrid-artifacts
MODELS_DIR=./.cache/models
SOURCE_REPO_DIR=./.cache/local-source
OPERATOR_DIR=./.cache/local-operator
LOCAL_UID=10001
LOCAL_GID=10001
RAG_SNAPSHOT_ID=enterprise-bge-base-canonical
RAG_DB_NAME=rag
# Operational idle-transaction cleanup; statement and lock limits stay 5s/2s.
RAG_DB_IDLE_TRANSACTION_TIMEOUT_MS=15000

# Three different secrets are required before the first DB volume is initialized.
# Changing these does not rotate roles on an existing database volume.
RAG_DB_BOOTSTRAP_PASSWORD=
RAG_DB_MIGRATOR_PASSWORD=
RAG_DB_RUNTIME_PASSWORD=

# Loopback HTTP only. HTTPS: secure=true, exception=false, exact HTTPS origins.
RAG_AUTH_ALLOWED_ORIGINS=
RAG_AUTH_SECURE_COOKIES=false
RAG_AUTH_ALLOW_INSECURE_LOOPBACK=true
RAG_AUTH_IDLE_SECONDS=1800
RAG_AUTH_ABSOLUTE_SECONDS=28800
RAG_DENSE_BLOCK_ROWS=8192
RAG_DENSE_FILE_CACHE_POLICY=retain
RAG_FP16=
RAG_BM25_WEIGHT=0.7
RAG_CANDIDATE_K=50
RAG_RERANK_K=50
RAG_RRF_K=60
RAG_ALLOWED_SOURCES=
# Optional further restriction file must live in the read-only staged /state.
RAG_ALLOWED_DOC_IDS_FILE=

# Live generation is a separate explicit opt-in, with real model/rates/budget.
ANTHROPIC_API_KEY=
RAG_MODEL=
RAG_INPUT_PRICE=0
RAG_OUTPUT_PRICE=0
RAG_QUESTION_BUDGET_USD=0.10
RAG_MAX_SECONDS=120
# HTTP includes policy resolution and persistence; the agent allowance stays at 120s.
RAG_REQUEST_TIMEOUT_SECONDS=180
RAG_MAX_TOKENS=16000
RAG_MAX_CONTEXT_CHARS=24000
# Router and answer generation retain this cap; critique has its own bounded cap.
RAG_MODEL_MAX_OUTPUT_TOKENS=1024
RAG_CRITIC_MAX_OUTPUT_TOKENS=2048
RAG_MAX_ROUNDS=2
RAG_TOP_K=5
RAG_EVIDENCE_DOC_LIMIT=8
# Immutable user IDs; empty denies all access to /observability data.
RAG_OBSERVABILITY_ADMIN_USER_IDS=
